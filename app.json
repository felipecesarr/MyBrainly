{
  "expo": {
    "name": "MyBrainly",
    "slug": "mybrainly-showcase",
    "version": "1.0.32",
    "projectId": "1b84d69d-f682-4f9f-aa27-ece8c1f6837b",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#f5b1ff"
    },
    "plugins": [
      [
        "expo-av",
        {
          "microphonePermission": "Allow $(PRODUCT_NAME) to access your microphone."
        }
      ]
    ],
    "scheme": "mybrainlyshowcase",
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "UIDeviceFamily": [
          1
        ]
      },
      "bundleIdentifier": "com.example.mybrainlyshowcase"
    },
    "android": {
      "useNextNotificationsApi": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptative.png",
        "backgroundColor": "#fff"
      },
      "splash": {
        "image": "./assets/splash.png",
        "resizeMode": "native",
        "backgroundColor": "#f5b1ff"
      },
      "package": "com.example.mybrainlyshowcase",
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "brainly",
              "host": "deck"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "versionCode": 7
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "FIREBASE_API_KEY": "YOUR_FIREBASE_API_KEY",
      "FIREBASE_AUTH_DOMAIN": "YOUR_FIREBASE_AUTH_DOMAIN",
      "FIREBASE_PROJECT_ID": "YOUR_FIREBASE_PROJECT_ID",
      "FIREBASE_STORAGE_BUCKET": "YOUR_FIREBASE_STORAGE_BUCKET",
      "FIREBASE_MESSAGING_SENDER_ID": "YOUR_FIREBASE_MESSAGING_SENDER_ID",
      "FIREBASE_APP_ID": "YOUR_FIREBASE_APP_ID",
      "FIREBASE_MEASUREMENT_ID": "YOUR_FIREBASE_MEASUREMENT_ID",
      "AI_DECK_ENDPOINT": "",
      "REVENUECAT_IOS_PUBLIC_SDK_KEY": "",
      "REVENUECAT_ANDROID_PUBLIC_SDK_KEY": ""
    },
    "runtimeVersion": "1.0.0"
  }
}
