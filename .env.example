# Public application configuration reference; all values are intentionally blank.
# The current Expo app reads app.json -> expo.extra, not this file automatically.
# Copy your own project's public client values to the corresponding app.json fields.
# Never put provider secrets, service-account keys or server credentials in the app.

FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# Optional HTTPS endpoint for your own authenticated server-side AI backend.
# The provider API key belongs only in that backend's secret storage.
AI_DECK_ENDPOINT=

# Optional RevenueCat PUBLIC SDK keys. Never use RevenueCat secret API keys here.
REVENUECAT_IOS_PUBLIC_SDK_KEY=
REVENUECAT_ANDROID_PUBLIC_SDK_KEY=
